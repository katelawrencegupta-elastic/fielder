{
  "name": "fielder-menubar",
  "version": "0.1.0",
  "private": true,
  "description": "macOS menu bar controller for Fielder",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . Fielder --platform=darwin --arch=universal --out=../dist-menubar --overwrite --prune=true --icon=icon.icns --app-bundle-id=com.fielder.menubar --extend-info=Info.plist"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-packager": "^17.1.2"
  }
}
