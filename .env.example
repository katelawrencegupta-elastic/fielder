# Optional: GitHub token for POC sync (raises rate limit)
# GITHUB_TOKEN=

# Scrappy meeting-notes search app
# SCRAPPY_URL=http://127.0.0.1:8787

# Daily calendar sources (priority):
# 1) Spark Desktop CLI (`spark events`) when Spark is running
# 2) Optional ICS file/URL (live Google/Outlook iCal)
# 3) calendar.json fallback when Spark + ICS are unavailable
# macOS Calendar scrape is off unless CALENDAR_ALLOW_MACOS=1
#
# Spark: Settings → AI Agents → Setup CLI (usually installs /usr/local/bin/spark)
# CALENDAR_SPARK=1
# SPARK_CLI_PATH=/usr/local/bin/spark
# SPARK_CALENDAR=you@company.com
#
# Fieldwork-exported meeting dump (used when Spark and ICS are unavailable).
# Defaults to ./calendar.json at the repo root.
# CALENDAR_JSON_PATH=
#
# Optional iCal feed (Google: Settings → Integrate calendar → Secret address in iCal format):
# CALENDAR_ICS_URL=
# CALENDAR_ICS_PATH=
#
# CALENDAR_ALLOW_MACOS=0
