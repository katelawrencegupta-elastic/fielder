{
  "name": "fielder",
  "version": "0.1.0",
  "private": true,
  "description": "Kanban task tracker + POC tracker for account execs and customers",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build:client": "npm run build --workspace client",
    "migrate:fieldwork": "node server/scripts/import-fieldwork.js",
    "seed": "node server/db/seed.js",
    "fielder": "bash scripts/fielder-ctl.sh",
    "menubar": "npm start --prefix menubar",
    "menubar:install": "bash scripts/install-menubar.sh",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "prepare": "bash scripts/install-git-hooks.sh"
  }
}
